// Storage rules for project cexindex. Deployed from this file — see the
// "storage" key in firebase.json. Deploy with:  firebase deploy --only storage
//
// Used by the visit PDF import (js/cqv-parser.js and js/nbo-parser.js + the
// import zone in admin.html / js/admin-page.js), which uploads CQV reports to
// cqvPdfs/ and NBO Coffee Visit reports to nboPdfs/. Those two prefixes are the
// only ones anything writes to — see the dormant visitPhotos/ block below.
//
// NOTE on admin-only writes: database.rules.json restricts writes
// (dashboardData, routineVisits, etc.) to admins via a lookup against the
// admins/{uid} Realtime Database node. Storage security rules can only read
// Firestore (via firestore.get(...)), not Realtime Database, so that same check
// can't be replicated here without adding Firebase custom claims + a Cloud
// Function to sync admins/{uid} into request.auth.token.admin — infrastructure
// this project doesn't otherwise have. Deliberately left as "any signed-in user"
// below; admin-only enforcement for the CQV import path stays client-side (the
// import zone only exists on admin.html, which already gates access via the
// same admins/{uid} check). Revisit if Storage ever needs to hold something
// more sensitive than these PDFs.

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /cqvPdfs/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }
    match /nboPdfs/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }
    // DORMANT — check-in photos. Attaching a photo to a check-in was built in
    // September 2026 and rolled back the same day: at the volume the dashboard
    // actually sees (~200 photos a month, ~270KB each after the client-side
    // downscale) it would take about eight years to reach the bucket's 5GB
    // free allowance, so the storage cost that justified the work was not real.
    // The client-side half is gone; see the repo history for it, and
    // storage.lifecycle.json for the retention rule that was written alongside.
    //
    // Writes are denied because nothing writes here any more. Leaving the
    // condition live would mean that deploying these rules — which happens for
    // the PDF paths above — opened an 8MB image-upload path to every signed-in
    // user, for a feature that does not exist. Restore the commented condition
    // to bring it back; the intent it encodes is worth keeping:
    //
    //   allow write: if request.auth != null
    //     && request.resource.size < 8 * 1024 * 1024
    //     && request.resource.contentType.matches('image/.*');
    //
    // The 8MB ceiling was headroom over the ~270KB the picker produced, there
    // to stop a bypassed client pushing raw multi-megabyte phone photos into
    // the bucket. A "max 3 per check-in" cap is not expressible here at all —
    // Storage rules cannot count sibling objects — so that limit lived in the
    // picker and in the visit record, never in this file.
    match /visitPhotos/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /{allOtherPaths=**} {
      allow read, write: if false;
    }
  }
}
