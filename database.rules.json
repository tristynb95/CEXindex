{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || !root.child('admins').exists())"
      }
    },

    "roles": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('roles').child(root.child('users').child(auth.uid).child('role').val()).child('permissions').child('admin').child('users').val() === 'edit')"
    },

    "users": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('roles').child(root.child('users').child(auth.uid).child('role').val()).child('permissions').child('admin').child('users').val() === 'view' || root.child('roles').child(root.child('users').child(auth.uid).child('role').val()).child('permissions').child('admin').child('users').val() === 'edit')",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.uid === $uid && data.exists() && newData.exists() && newData.child('role').val() === data.child('role').val() && newData.child('myActivity').val() === data.child('myActivity').val() && newData.child('managerUid').val() === data.child('managerUid').val()) || (root.child('roles').child(root.child('users').child(auth.uid).child('role').val()).child('permissions').child('admin').child('users').val() === 'edit' && newData.child('role').val() !== 'admin' && data.child('role').val() !== 'admin'))"
      }
    },

    "userDirectory": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && ($uid === auth.uid || root.child('admins').child(auth.uid).val() === true || root.child('roles').child(root.child('users').child(auth.uid).child('role').val()).child('permissions').child('admin').child('users').val() === 'edit')",
        ".validate": "!newData.exists() || (newData.hasChildren(['name']) && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 120 && (!newData.child('email').exists() || (newData.child('email').isString() && newData.child('email').val().length <= 160)) && !newData.hasChild('role') && !newData.hasChild('opsArea'))"
      }
    },

    "teamDirectory": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('roles').child(root.child('users').child(auth.uid).child('role').val()).child('permissions').child('teamScope').val() === 'direct' || root.child('roles').child(root.child('users').child(auth.uid).child('role').val()).child('permissions').child('teamScope').val() === 'all' || root.child('roles').child(root.child('users').child(auth.uid).child('role').val()).child('permissions').child('admin').child('users').val() === 'view' || root.child('roles').child(root.child('users').child(auth.uid).child('role').val()).child('permissions').child('admin').child('users').val() === 'edit')",
      "$uid": {
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('roles').child(root.child('users').child(auth.uid).child('role').val()).child('permissions').child('admin').child('users').val() === 'edit')",
        ".validate": "!newData.exists() || (newData.hasChildren(['name']) && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 120 && (!newData.child('managerUid').exists() || (newData.child('managerUid').isString() && newData.child('managerUid').val() !== $uid)))"
      }
    },

    "appSettings": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('roles').child(root.child('users').child(auth.uid).child('role').val()).child('permissions').child('admin').child('users').val() === 'edit')"
    },

    "dashboardData": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('roles').child(root.child('users').child(auth.uid).child('role').val()).child('permissions').child('admin').child('dataset').val() === 'edit')"
    },

    "dashboardMeta": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('roles').child(root.child('users').child(auth.uid).child('role').val()).child('permissions').child('admin').child('dataset').val() === 'edit')"
    },

    "portalData": {
      "siteMeta": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('roles').child(root.child('users').child(auth.uid).child('role').val()).child('permissions').child('admin').child('sites').val() === 'edit')"
      }
    },

    "activityLog": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('roles').child(root.child('users').child(auth.uid).child('role').val()).child('permissions').child('admin').child('users').val() === 'view' || root.child('roles').child(root.child('users').child(auth.uid).child('role').val()).child('permissions').child('admin').child('users').val() === 'edit')",
      "$entry": {
        ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid"
      }
    },

    "routineVisits": {
      ".read": "auth != null",
      "$visitId": {
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('roles').child(root.child('users').child(auth.uid).child('role').val()).child('permissions').child('admin').child('visits').val() === 'edit' || (!data.exists() && (root.child('users').child(auth.uid).child('role').val() === 'viewer' || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('roles').child(root.child('users').child(auth.uid).child('role').val()).child('permissions').child('actions').child('logVisits').val() === true)))"
      }
    },

    "followUpActions": {
      ".read": "auth != null",
      "$taskId": {
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('roles').child(root.child('users').child(auth.uid).child('role').val()).child('permissions').child('admin').child('visits').val() === 'edit' || root.child('users').child(auth.uid).child('role').val() === 'viewer' || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('roles').child(root.child('users').child(auth.uid).child('role').val()).child('permissions').child('actions').child('logVisits').val() === true)"
      }
    },

    "bakeryNotes": {
      ".read": "auth != null",
      "$bakeryKey": {
        "$noteId": {
          ".write": "auth != null && ((!data.exists() && newData.exists() && (root.child('admins').child(auth.uid).val() === true || root.child('users').child(auth.uid).child('role').val() === 'viewer' || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('roles').child(root.child('users').child(auth.uid).child('role').val()).child('permissions').child('actions').child('logVisits').val() === true)) || (data.exists() && newData.exists() && (data.child('createdBy').child('uid').val() === auth.uid || root.child('admins').child(auth.uid).val() === true || root.child('users').child(auth.uid).child('role').val() === 'admin')) || (data.exists() && !newData.exists() && (root.child('admins').child(auth.uid).val() === true || root.child('users').child(auth.uid).child('role').val() === 'admin')))",
          ".validate": "!newData.exists() || (newData.hasChildren(['bakery', 'body', 'createdAt', 'createdBy']) && newData.child('bakery').isString() && newData.child('bakery').val().length <= 160 && newData.child('body').isString() && newData.child('body').val().length > 0 && newData.child('body').val().length <= 2000 && (newData.child('createdBy').child('uid').val() === auth.uid || (data.exists() && newData.child('createdBy').child('uid').val() === data.child('createdBy').child('uid').val())))"
        }
      }
    }
  }
}
