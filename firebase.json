{
  "database": {
    "rules": "database.rules.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": ".",
    "headers": [
      {
        "source": "**/*.@(html|js|css)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|gif|svg|ico|webp|woff|woff2)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
      }
    ],
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".gitignore",
      ".firebase",
      ".firebase/**",
      ".git",
      ".git/**",
      ".github",
      ".github/**",
      ".vscode",
      ".vscode/**",
      "apps-script",
      "apps-script/**",
      "tmp",
      "tmp/**",
      "test",
      "test/**",
      "admin-setup.html",
      "database.rules.json",
      "storage.rules",
      "eslint.config.mjs",
      "package.json",
      "package-lock.json",
      "README.md",
      "firebase-debug.log",
      "**/.*",
      "**/.*/**",
      "**/node_modules/**"
    ]
  }
}
