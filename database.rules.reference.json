{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null"
      }
    },

    "admins": {
      ".read": "auth != null",
      "$uid": {
        ".write": "root.child('admins').child(auth.uid).val() === true"
      }
    },

    "portalData": {
      ".read": "auth != null",
      ".write": "root.child('admins').child(auth.uid).val() === true"
    },

    "dashboardData": {
      ".read": "auth != null",
      ".write": "root.child('admins').child(auth.uid).val() === true"
    },

    "dashboardMeta": {
      ".read": "auth != null",
      ".write": "root.child('admins').child(auth.uid).val() === true"
    },

    "activityLog": {
      ".read": "root.child('admins').child(auth.uid).val() === true",
      "$entryId": {
        ".write": "auth != null && !data.exists()"
      }
    },

    "routineVisits": {
      ".read": "auth != null",
      "$visitId": {
        ".write": "root.child('admins').child(auth.uid).val() === true"
      }
    }
  }
}
