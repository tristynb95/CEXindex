{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || !root.child('admins').exists())"
      }
    },

    "roles": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('roles').child(root.child('users').child(auth.uid).child('role').val()).child('permissions').child('admin').child('users').val() === 'edit')"
    },

    "users": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('roles').child(root.child('users').child(auth.uid).child('role').val()).child('permissions').child('admin').child('users').val() === 'view' || root.child('roles').child(root.child('users').child(auth.uid).child('role').val()).child('permissions').child('admin').child('users').val() === 'edit')",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.uid === $uid && data.exists() && newData.exists() && newData.child('role').val() === data.child('role').val()) || (root.child('roles').child(root.child('users').child(auth.uid).child('role').val()).child('permissions').child('admin').child('users').val() === 'edit' && newData.child('role').val() !== 'admin' && data.child('role').val() !== 'admin'))"
      }
    },

    "dashboardData": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('roles').child(root.child('users').child(auth.uid).child('role').val()).child('permissions').child('admin').child('dataset').val() === 'edit')"
    },

    "dashboardMeta": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('roles').child(root.child('users').child(auth.uid).child('role').val()).child('permissions').child('admin').child('dataset').val() === 'edit')"
    },

    "portalData": {
      "siteMeta": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('roles').child(root.child('users').child(auth.uid).child('role').val()).child('permissions').child('admin').child('sites').val() === 'edit')"
      }
    },

    "activityLog": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('roles').child(root.child('users').child(auth.uid).child('role').val()).child('permissions').child('admin').child('users').val() === 'view' || root.child('roles').child(root.child('users').child(auth.uid).child('role').val()).child('permissions').child('admin').child('users').val() === 'edit')",
      "$entry": {
        ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid"
      }
    },

    "routineVisits": {
      ".read": "auth != null",
      "$visitId": {
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('roles').child(root.child('users').child(auth.uid).child('role').val()).child('permissions').child('admin').child('visits').val() === 'edit' || (!data.exists() && (root.child('users').child(auth.uid).child('role').val() === 'viewer' || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('roles').child(root.child('users').child(auth.uid).child('role').val()).child('permissions').child('actions').child('logVisits').val() === true)))"
      }
    }
  }
}
